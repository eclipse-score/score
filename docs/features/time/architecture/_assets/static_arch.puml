@startuml

title Time feature static architecture

legend top left
| <#LightCoral>  | external time source |
| <#LightGrey>   | OS / local time base |
| <#LightBlue>   | score platform stack |
| <#LightGreen>  | score::time feature  |
| <#LightSalmon> | application          |
endlegend

rectangle "ECU" #f0f5f5 {
  actor "Feature User" as user #LightSalmon

  package "score::time" #e6ffe6 {
    component "Vehicle Clock" as vc #LightGreen
    component "Local Clock" as lc #LightGreen
    component "Absolute Clock" as ac #LightGreen
  }

  component "score::someip" as someip #LightBlue
  component "OS / local clock" as os #LightGrey
}

cloud "Vehicle network time\n(PTP)" as veh #LightCoral
cloud "Absolute time source\n(e.g. GPS / UTC)" as abs #LightCoral

user --> vc : read vehicle time
user --> lc : read local time
user --> ac : read absolute time

vc ..> veh : synchronized to (PTP)
lc ..> os : reads
ac ..> someip : IPC
someip ..> abs : obtains absolute time

@enduml
