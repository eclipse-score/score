{
    "_comment": "Configuration of the FEP Final Comment Period bot, see docs/contribute/contribution_request/feature_request.rst",
    "fep_label": "fep",
    "fcp_label": "fep:fcp",
    "breaking_change_label": "fep:breaking-change",
    "fcp_days": 14,
    "max_resets": 1,
    "reminder_days_before": [
        7,
        2
    ],
    "breaking_change_quorum": 3,
    "quorum_group": "Architecture Community",
    "bot_login": "github-actions[bot]",
    "known_good_url": "https://raw.githubusercontent.com/eclipse-score/reference_integration/main/known_good.json",
    "known_good_groups": [
        "target_sw"
    ],
    "extra_registry_modules": [
        "score_docs_as_code",
        "score_itf",
        "score_test_scenarios"
    ],
    "registry_metadata_url": "https://raw.githubusercontent.com/eclipse-score/bazel_registry/main/modules/{module}/metadata.json",
    "extra_stakeholders": {},
    "codeowners_file": ".github/CODEOWNERS",
    "codeowners_stakeholders": {
        "Architecture Community": "/docs/features/"
    },
    "chair_and_proxy_codeowners": "/docs/design_decisions/architecture/"
}
